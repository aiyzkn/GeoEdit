<?xml version="1.0" encoding="UTF-8"?>
<!--
  時刻データを持たない GPX。標高置換や「単純接続」結合など、時刻が無くても動く
  経路のテストや、時刻データ必須の操作がエラーになることの確認に使う。
  標高は付与済み（標高API自動補完を発動させないため）。
-->
<gpx version="1.1" creator="e2e-fixture" xmlns="http://www.topografix.com/GPX/1/1">
  <trk>
    <name>No Time Track</name>
    <trkseg>
      <trkpt lat="35.690000" lon="139.700000"><ele>10.0</ele></trkpt>
      <trkpt lat="35.691000" lon="139.701000"><ele>12.0</ele></trkpt>
      <trkpt lat="35.692000" lon="139.702000"><ele>14.0</ele></trkpt>
    </trkseg>
  </trk>
</gpx>
